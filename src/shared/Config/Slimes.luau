--!strict
-- Every slime in the game. Models are generated from these fields by
-- SlimeBuilder, so adding a slime is just adding a row here.
--
-- Price is in-game cash. Income is cash per second while it sits in a base.
-- Payback (Price / Income) grows with rarity so upgrades always feel earned.

export type SlimeDef = {
	Id: string,
	Name: string,
	Rarity: string,
	Price: number,
	Income: number,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	Size: number,
	Hat: string?,
	-- Looks (SlimeBuilder): every slime gets its own combination so none look alike.
	Shape: string?, -- Round (default), Tall, Flat, Chunky, Drop
	Face: string?, -- Happy (default), Cute, Angry, Sleepy, Cyclops, Cool, Fangs, Glow, Derp, Sparkle, Boo, Jack
	Extras: { string }?, -- see Looks.Extras
	Accent: Color3?, -- colour for spots, wings, glowing eyes... (default: a paler body colour)
	Glow: boolean?,
	Event: string?, -- only spawns while this event is active
	MergeOnly: boolean?, -- never on the belt: only made by merging
	MergeInto: string?, -- merging three of these makes this slime instead of a Giant
	RobuxOnly: boolean?, -- never on the belt: only from its Robux pack
}

